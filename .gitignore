# Environment / OS
.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
.ipynb_checkpoints/

# Challenge data (never commit; uploaded to Kaggle as a private dataset)
dataset/
dataset_synth/
*.tsv
*.zip

# Generated outputs (rebuilt by the pipeline; carried between Kaggle sessions as notebook output)
output/
artifacts/*
