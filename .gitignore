!artifacts/splits/
!artifacts/model/
artifacts/model/*
!artifacts/model/model_dev_frozen_*.txt
!artifacts/model/oof_dev_frozen.parquet
!artifacts/model/folds_dev_frozen.parquet
!artifacts/model/meta_dev_frozen.json
